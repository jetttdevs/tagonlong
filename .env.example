# Which role this process runs: api | indexer | bot | worker
PROCESS=api

# ---------------------------------------------------------------------------
# Network — Robinhood Chain (Arbitrum Orbit L2, gas in ETH)
#   mainnet 4663 · testnet 46630
# ---------------------------------------------------------------------------
CHAIN_ENV=testnet
RPC_URL_MAINNET=https://rpc.mainnet.chain.robinhood.com
RPC_URL_TESTNET=https://rpc.testnet.chain.robinhood.com
# The public RPCs are rate limited and documented for prototyping, not
# production traffic. Use a dedicated provider before taking real load.

# ---------------------------------------------------------------------------
# Long.xyz — the launchpad contracts this is built on
# ---------------------------------------------------------------------------
# MAINNET pair (chain 4663). The only one Long.xyz publishes.
LONG_FACTORY_MAINNET=0x22e99278308b393ea1260859b181ad7e78f5eeed
LONG_AIRLOCK_MAINNET=0xeb7c034704ef8dcd2d32324c1545f62fb4ad0862

# TESTNET pair (chain 46630). Blank because Long.xyz does not publish it and may
# not be deployed there at all. Look it up on the testnet explorer before using
# CHAIN_ENV=testnet — the app refuses to start if these addresses have no code.
LONG_FACTORY_TESTNET=
LONG_AIRLOCK_TESTNET=

# Block the indexer backfills from. Find it on the explorer; 0 scans from
# genesis, which is slow and will rate-limit you.
LONG_DEPLOY_BLOCK=0

# The factory's create() ABI is not published, so it is not filled in. Until it
# is, the worker broadcasts nothing. See the note above launchAbi in src/index.ts.
LAUNCH_MODE=simulate

# ---------------------------------------------------------------------------
# Fee vaults — one address per X account
# ---------------------------------------------------------------------------
# Deployed FeeVaultFactory (contracts/FeeVault.sol).
FEE_VAULT_FACTORY=

# Signs "X user id N may be claimed by 0x…". NOT a treasury key: it cannot
# withdraw from a vault, redirect funds already in one, or skip the 48h delay
# guarding a claimed vault. Keep it separate from RELAYER_KEY.
ATTESTOR_KEY=

# ---------------------------------------------------------------------------
# Relayer + revenue
# ---------------------------------------------------------------------------
# Gas wallet only. Never receives a launched asset, never a fee recipient.
# Keep days of gas in it, not months. Use a KMS in production.
RELAYER_KEY=

# Where the platform's share of fees goes.
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# X (Twitter)
# ---------------------------------------------------------------------------
# Bearer reads mentions; the OAuth 1.0a set posts replies.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=tagonlong

# ---------------------------------------------------------------------------
# Reply agent (optional)
# ---------------------------------------------------------------------------
# When set, Claude phrases the bot's replies. It never decides an outcome —
# validation does that before anything reaches it. Unset is a working setup.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tagonlong:tagonlong@localhost:5432/tagonlong
REDIS_URL=redis://localhost:6379
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# openssl rand -hex 32
ADMIN_JWT_SECRET=

# Wallets allowed into the admin panel. Empty means nobody can sign in, so a
# running bot would have no kill switch — the app refuses to start.
ADMIN_ALLOWLIST=
